// Cloudflare Workers の設定（静的サイトとして公開する）
// https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-fujita-create",
  "compatibility_date": "2026-11-01",
  // 公開ドメイン（DNS と SSL 証明書は Cloudflare が自動で設定する）
  "routes": [{ "pattern": "site.fujita-create.com", "custom_domain": true }],
  "assets": {
    // npm run build で作られるフォルダをそのまま公開する
    "directory": "./dist",
    // 存在しない URL では 404.html を返す
    "not_found_handling": "404-page"
  }
}
