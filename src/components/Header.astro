---
import { company, nav } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path === href.replace(/\/$/, '');
---

<header class="header">
  <a href="/" class="brand">
    <span class="brand-mark" aria-hidden="true"></span>
    <span class="brand-text">
      <span class="brand-name">{company.name}</span>
      <span class="brand-en">{company.nameEn}</span>
    </span>
  </a>

  <button class="menu-button" type="button" aria-expanded="false" aria-controls="global-nav">
    <span class="menu-icon" aria-hidden="true"></span>
    <span class="visually-hidden">メニュー</span>
  </button>

  <nav id="global-nav" class="nav" aria-label="グローバルナビゲーション">
    {
      nav.map((item) => (
        <a href={item.href} class="nav-link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
          <span>{item.label}</span>
          <span class="nav-en">{item.en}</span>
        </a>
      ))
    }
    <a href="/contact/" class="nav-link nav-contact" aria-current={isCurrent('/contact/') ? 'page' : undefined}>
      <span>お問い合わせ</span>
      <span class="nav-en">CONTACT</span>
    </a>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const header = document.querySelector<HTMLElement>('.header');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('is-open', open);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    height: var(--header-h);
    padding-left: var(--gutter);
    background: #fff;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand-mark {
    flex: none;
    width: 26px;
    height: 26px;
    background: var(--ink);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .brand-name {
    font-size: clamp(14px, 1.4vw, 17px);
    font-weight: 700;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .brand-en {
    font: 600 10px var(--font-en);
    letter-spacing: 0.22em;
    color: var(--muted);
  }

  .nav {
    display: flex;
    align-items: stretch;
    height: 100%;
    font-size: 14px;
    font-weight: 500;
  }

  .nav-link {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 clamp(10px, 1.6vw, 24px);
    line-height: 1.3;
    white-space: nowrap;
  }

  .nav-en {
    font: 600 9px var(--font-en);
    letter-spacing: 0.18em;
    color: var(--muted-2);
  }

  .nav-link[aria-current='page']:not(.nav-contact)::after {
    content: '';
    position: absolute;
    left: clamp(10px, 1.6vw, 24px);
    right: clamp(10px, 1.6vw, 24px);
    bottom: 0;
    height: 3px;
    background: var(--ink);
  }

  .nav-contact {
    padding: 0 clamp(16px, 2.6vw, 40px);
    background: var(--ink);
    color: #fff;
  }

  .nav-contact .nav-en {
    color: #aaa;
  }

  .menu-button {
    display: none;
  }

  @media (max-width: 960px) {
    .header {
      padding-right: 0;
    }

    .menu-button {
      display: grid;
      place-items: center;
      width: var(--header-h);
      height: var(--header-h);
      margin-left: auto;
      padding: 0;
      border: 0;
      background: var(--ink);
      cursor: pointer;
    }

    .menu-icon,
    .menu-icon::before,
    .menu-icon::after {
      display: block;
      width: 22px;
      height: 2px;
      background: #fff;
      transition: transform 0.2s, background 0.2s;
    }

    .menu-icon {
      position: relative;
    }

    .menu-icon::before,
    .menu-icon::after {
      content: '';
      position: absolute;
      left: 0;
    }

    .menu-icon::before {
      top: -7px;
    }

    .menu-icon::after {
      top: 7px;
    }

    .is-open .menu-icon {
      background: transparent;
    }

    .is-open .menu-icon::before {
      transform: translateY(7px) rotate(45deg);
    }

    .is-open .menu-icon::after {
      transform: translateY(-7px) rotate(-45deg);
    }

    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      height: auto;
      background: #fff;
      border-bottom: 1px solid var(--line);
      font-size: 16px;
    }

    .is-open .nav {
      display: flex;
    }

    .nav-link {
      padding: 18px var(--gutter);
      border-top: 1px solid var(--line);
    }

    .nav-link[aria-current='page']:not(.nav-contact)::after {
      left: 0;
      right: auto;
      top: 0;
      width: 3px;
      height: auto;
    }
  }

  @media (max-width: 600px) {
    .brand {
      gap: 10px;
    }

    .brand-mark {
      width: 20px;
      height: 20px;
    }
  }
</style>
