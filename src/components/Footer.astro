---
import { company, companyInfo, nav } from '../data/site';
---

<footer class="footer container">
  <div class="footer-main">
    <div class="footer-brand">
      <a href="/" class="brand">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-text">
          <span class="brand-name">{company.name}</span>
          <span class="brand-en">{company.nameEn}</span>
        </span>
      </a>
      <nav class="footer-nav" aria-label="フッターナビゲーション">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/contact/">お問い合わせ</a>
      </nav>
    </div>
    <dl class="info">
      {
        companyInfo.map((row) => (
          <div class="info-row">
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
  <div class="footer-bottom">
    <a href="/privacy/">プライバシーポリシー</a>
    <small class="en">© 2026 {company.copyright}</small>
  </div>
</footer>

<style>
  .footer {
    padding-block: 72px 32px;
    border-top: 1px solid var(--line);
    background: #fff;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--split-gap);
    padding-bottom: 56px;
    border-bottom: 1px solid var(--line);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand-mark {
    width: 22px;
    height: 22px;
    background: var(--accent);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .brand-name {
    font-size: 16px;
    font-weight: 700;
  }

  .brand-en {
    font: 600 10px var(--font-en);
    letter-spacing: 0.22em;
    color: var(--muted);
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 13px;
  }

  /* 2列×4行。各行は上下に罫線 */
  .info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24px;
    font-size: 13px;
    line-height: 1.8;
  }

  .info-row {
    display: grid;
    grid-template-columns: 5.5em minmax(0, 1fr);
    column-gap: 24px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }

  .info-row:nth-last-child(-n + 2) {
    border-bottom: 1px solid var(--line);
  }

  dt {
    color: var(--muted);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    font-size: 12px;
    color: var(--muted);
  }

  .footer-bottom small {
    font-size: inherit;
  }

  @media (max-width: 900px) {
    .footer-main {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 600px) {
    .footer {
      padding-block: 56px 28px;
    }

    .info {
      grid-template-columns: minmax(0, 1fr);
    }

    .info-row:nth-last-child(2) {
      border-bottom: 0;
    }

    .footer-bottom {
      flex-direction: column-reverse;
    }
  }
</style>
