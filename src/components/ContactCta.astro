---
import Wave from './Wave.astro';

interface Props {
  waveColor?: string;
}

const { waveColor = '#fff' } = Astro.props;
---

<section class="cta container">
  <Wave color={waveColor} position="top" />
  <div>
    <div class="eyebrow">CONTACT</div>
    <p class="cta-title">開発のご相談・お見積り</p>
  </div>
  <a href="/contact/" class="cta-button">お問い合わせフォーム →</a>
</section>

<style>
  .cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    position: relative;
    padding-block: clamp(96px, 12vw, 160px) 72px;
    border-bottom: 1px solid var(--accent-line);
    background: var(--accent);
    color: #fff;
  }

  .eyebrow {
    color: #fff;
    margin-bottom: 12px;
  }

  .cta-title {
    font-size: 32px;
    font-weight: 700;
  }

  .cta-button {
    flex: none;
    padding: 22px 56px;
    border-radius: 999px;
    background: #fff;
    color: var(--accent-deep);
    font-size: 15px;
    font-weight: 700;
  }

  @media (max-width: 700px) {
    .cta {
      flex-direction: column;
      align-items: stretch;
      padding-block: 88px 56px;
    }

    .cta-title {
      font-size: 24px;
    }

    .cta-button {
      text-align: center;
      padding: 20px 24px;
    }
  }
</style>
