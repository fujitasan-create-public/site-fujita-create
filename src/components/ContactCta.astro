---
import Wave from './Wave.astro';

interface Props {
  // 直前のセクションが色付きのとき、その色を指定すると上端を波にする
  waveColor?: string;
}

const { waveColor } = Astro.props;
---

<section class:list={['cta container', { 'has-wave': waveColor }]}>
  {waveColor && <Wave color={waveColor} position="top" />}
  <div>
    <div class="eyebrow" data-reveal>CONTACT</div>
    <p class="cta-title" data-reveal style="--reveal-delay: 100ms">開発のご相談・業務委託のご依頼</p>
    <p class="cta-lead" data-reveal style="--reveal-delay: 150ms">
      開発のご依頼に加え、開発会社さまからの業務委託・プロジェクト参画のご相談も承っています。
    </p>
  </div>
  <a href="/contact/" class="cta-button" data-reveal style="--reveal-delay: 200ms">お問い合わせフォーム →</a>
</section>

<style>
  .cta {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    padding-block: 72px;
    border-top: 1px solid var(--line);
    background: #fff;
  }

  .has-wave {
    padding-top: clamp(96px, 12vw, 160px);
    border-top: 0;
  }

  .eyebrow {
    margin-bottom: 12px;
  }

  .cta-title {
    font-size: 32px;
    font-weight: 700;
  }

  .cta-lead {
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.9;
    color: var(--text);
  }

  .cta-button {
    flex: none;
    padding: 22px 56px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 15px;
    font-weight: 700;
  }

  @media (max-width: 700px) {
    .cta {
      flex-direction: column;
      align-items: stretch;
      padding-block: 56px;
    }

    .has-wave {
      padding-top: 88px;
    }

    .cta-title {
      font-size: 24px;
    }

    .cta-button {
      text-align: center;
      padding: 20px 24px;
    }
  }
</style>
