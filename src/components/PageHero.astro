---
import Wave from './Wave.astro';

// 下層ページ上部のビジュアル＋ページタイトル＋パンくず
interface Props {
  title: string;
  // 見出し上の英字（省略すると出さない）
  en?: string;
  // 背景にループ再生する動画（public/ からのパス）と、読み込み前に出す静止画
  video?: string;
  poster?: string;
  // トップ用の大きなヒーローにする
  large?: boolean;
  // public/ に置いた画像のパス。未設定ならプレースホルダー表示
  image?: string;
  // 画像が入るまで表示する、想定写真のメモ
  note?: string;
  // パンくずリストを出すか（トップページでは出さない）
  breadcrumb?: boolean;
  // 下端の波の色（直後のセクションの背景色に合わせる）
  waveColor?: string;
}

const { title, en, video, poster, large = false, image, note, breadcrumb = true, waveColor = '#fff' } = Astro.props;
const hasMedia = Boolean(image || video);
---

<div class:list={['hero', { 'hero-large': large }]} style={image ? `background-image: url(${image})` : undefined}>
  {
    video && (
      <video
        class="hero-video"
        src={video}
        poster={poster}
        autoplay
        muted
        loop
        playsinline
        disablepictureinpicture
        preload="auto"
        aria-hidden="true"
      />
    )
  }
  {!hasMedia && note && <span class="note">{note}</span>}
  <div class="hero-text">
    {en && <div class="eyebrow">{en}</div>}
    {/* 改行などを入れたいときは、中身を slot で渡す */}
    <h1>{Astro.slots.has('default') ? <slot /> : title}</h1>
    {/* 見出しの下に添える文（英語のサブコピーなど） */}
    <slot name="sub" />
  </div>
  <Wave color={waveColor} />
</div>
{
  breadcrumb && (
    <nav class="breadcrumb container" aria-label="パンくずリスト">
      <a href="/">トップ</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>
  )
}

<style>
  .hero {
    position: relative;
    height: 400px;
    background:
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 12px),
      #4a4a4a;
    background-size: cover;
    background-position: center;
  }

  /*
   * ヘッダーの下を動画で画面いっぱいにする。
   * 下端の波（Wave と同じ高さ）は画面の外に出し、スクロールして初めて見えるようにする。
   */
  /* 画面幅ごとの .hero の高さ指定より優先させるため、2 つのクラスで指定 */
  .hero.hero-large {
    --wave-h: clamp(36px, 6vw, 96px);
    height: calc(100vh - var(--header-h) + var(--wave-h));
    height: calc(100svh - var(--header-h) + var(--wave-h));
    min-height: 480px;
  }

  /* 文字のかたまりを少し右に寄せる */
  .hero-large .hero-text {
    left: clamp(20px, 9vw, 160px);
    bottom: calc(var(--wave-h) + clamp(48px, 8vw, 110px));
  }

  .hero-large h1 {
    font-size: clamp(44px, 7vw, 100px);
    line-height: 1.35;
    letter-spacing: 0.04em;
  }

  /* 操作できない背景動画（コントロールなし・クリック無効） */
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* 写真を入れたときに文字が読めるよう、下側を少し暗くする */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.35), transparent 60%);
  }

  /* 明るい動画の上でも白い見出しが読めるよう、少し強めに暗くする */
  .hero-large::after {
    background:
      linear-gradient(to top, rgba(0, 0, 0, 0.45), transparent 65%),
      rgba(0, 0, 0, 0.12);
  }

  .note {
    position: absolute;
    right: 24px;
    top: 20px;
    font: 11px var(--font-mono);
    color: #bbb;
  }

  .hero-text {
    position: absolute;
    z-index: 1;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(64px, 9vw, 120px);
    color: #fff;
  }

  .eyebrow {
    color: #d0d0d0;
    letter-spacing: 0.32em;
    margin-bottom: 16px;
  }

  h1 {
    font-size: 56px;
    font-weight: 700;
    line-height: 1.3;
  }

  .breadcrumb {
    display: flex;
    gap: 10px;
    padding-block: 20px;
    font-size: 12px;
    color: var(--muted);
  }

  [aria-current='page'] {
    color: var(--ink);
  }

  @media (max-width: 600px) {
    .hero {
      height: 280px;
    }

    .note {
      display: none;
    }

    .hero-text {
      bottom: 56px;
    }

    h1 {
      font-size: 34px;
    }
  }
</style>
