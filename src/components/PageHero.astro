---
import Wave from './Wave.astro';

// 下層ページ上部のビジュアル＋ページタイトル＋パンくず
interface Props {
  title: string;
  en: string;
  // public/ に置いた画像のパス。未設定ならプレースホルダー表示
  image?: string;
  // 画像が入るまで表示する、想定写真のメモ
  note?: string;
  // パンくずリストを出すか（トップページでは出さない）
  breadcrumb?: boolean;
  // 下端の波の色（直後のセクションの背景色に合わせる）
  waveColor?: string;
}

const { title, en, image, note, breadcrumb = true, waveColor = '#fff' } = Astro.props;
---

<div class="hero" style={image ? `background-image: url(${image})` : undefined}>
  {!image && note && <span class="note">{note}</span>}
  <div class="hero-text">
    <div class="eyebrow">{en}</div>
    <h1>{title}</h1>
  </div>
  <Wave color={waveColor} />
</div>
{
  breadcrumb && (
    <nav class="breadcrumb container" aria-label="パンくずリスト">
      <a href="/">トップ</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>
  )
}

<style>
  .hero {
    position: relative;
    height: 400px;
    background:
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 12px),
      #4a4a4a;
    background-size: cover;
    background-position: center;
  }

  /* 写真を入れたときに文字が読めるよう、下側を少し暗くする */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.35), transparent 60%);
  }

  .note {
    position: absolute;
    right: 24px;
    top: 20px;
    font: 11px var(--font-mono);
    color: #bbb;
  }

  .hero-text {
    position: absolute;
    z-index: 1;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(64px, 9vw, 120px);
    color: #fff;
  }

  .eyebrow {
    color: #d0d0d0;
    letter-spacing: 0.32em;
    margin-bottom: 16px;
  }

  h1 {
    font-size: 56px;
    font-weight: 700;
    line-height: 1.3;
  }

  .breadcrumb {
    display: flex;
    gap: 10px;
    padding-block: 20px;
    font-size: 12px;
    color: var(--muted);
  }

  [aria-current='page'] {
    color: var(--ink);
  }

  @media (max-width: 600px) {
    .hero {
      height: 280px;
    }

    .note {
      display: none;
    }

    .hero-text {
      bottom: 56px;
    }

    h1 {
      font-size: 34px;
    }
  }
</style>
