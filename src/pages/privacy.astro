---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../data/site';

// ※ たたき台です。公開前に内容を確認・修正してください。
const sections = [
  {
    title: '個人情報の取得',
    text: '当社は、お問い合わせフォームやメールを通じて、お名前・会社名・メールアドレス・お問い合わせ内容などの個人情報を取得します。',
  },
  {
    title: '利用目的',
    text: '取得した個人情報は、お問い合わせへの回答、ご依頼に関するご連絡、業務の遂行のために利用し、それ以外の目的には利用しません。',
  },
  {
    title: '第三者への提供',
    text: '法令に基づく場合を除き、ご本人の同意なく個人情報を第三者に提供することはありません。',
  },
  {
    title: '安全管理',
    text: '個人情報の漏えい・滅失・毀損を防ぐため、必要かつ適切な安全管理措置を講じます。',
  },
  {
    title: '開示・訂正・削除',
    text: `ご本人から個人情報の開示・訂正・削除のご請求があった場合は、本人確認のうえ速やかに対応します。${company.email} までご連絡ください。`,
  },
  {
    title: '改定',
    text: '本ポリシーの内容は、必要に応じて変更することがあります。変更後の内容は本ページに掲載した時点から効力を生じます。',
  },
];
---

<BaseLayout title="プライバシーポリシー" description={`${company.name}の個人情報の取り扱いについて。`}>
  <section class="container privacy">
    <div class="eyebrow">PRIVACY POLICY</div>
    <h1>プライバシーポリシー</h1>
    <p class="lead">{company.name}（以下「当社」）は、お客様の個人情報を以下のとおり取り扱います。</p>
    <ol>
      {
        sections.map((s) => (
          <li>
            <h2>{s.title}</h2>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="date">制定日：2026年10月　{company.name}</p>
  </section>
</BaseLayout>

<style>
  .privacy {
    max-width: calc(800px + var(--gutter) * 2);
    margin-inline: auto;
    padding-block: 96px 120px;
  }

  h1 {
    margin-bottom: 32px;
    font-size: 40px;
    font-weight: 700;
  }

  .lead {
    margin-bottom: 48px;
    font-size: 15px;
    line-height: 2;
    color: var(--text);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: item;
    border-top: 2px solid var(--accent);
  }

  li {
    padding: 28px 0;
    border-bottom: 1px solid var(--line-strong);
    counter-increment: item;
  }

  h2 {
    margin-bottom: 10px;
    font-size: 18px;
    font-weight: 700;
  }

  h2::before {
    content: counter(item, decimal-leading-zero) '　';
    font-family: var(--font-en);
    color: #aaa;
  }

  li p {
    font-size: 14px;
    line-height: 2;
    color: var(--text-sub);
  }

  .date {
    margin-top: 40px;
    text-align: right;
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .privacy {
      padding-block: 64px 80px;
    }

    h1 {
      font-size: 28px;
    }
  }
</style>
