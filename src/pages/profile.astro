---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Wave from '../components/Wave.astro';
import { career, company, skills } from '../data/site';

// 代表者の写真。public/ に画像を置いてパスを入れると表示されます
const portrait: string | undefined = undefined;
---

<BaseLayout ctaWaveColor="var(--accent-soft)" title="代表者について" description="合同会社Fujita-create 代表社員の経歴と得意分野をご紹介します。">
  <PageHero title="代表者について" en="PROFILE" note="PAGE VISUAL — 光と影（2560×720）" />

  <section class="split container intro">
    {
      portrait ? (
        <img src={portrait} alt={`代表社員 ${company.representative}`} class="portrait" data-reveal />
      ) : (
        <div class="portrait placeholder" data-reveal>PORTRAIT 3:4（任意・後ろ姿や手元でも可）</div>
      )
    }
    <div>
      <div class="role" data-reveal>代表社員</div>
      <div class="name" data-reveal>
        <span class="name-ja">{company.representative}</span>
        <span class="name-en en">{company.representativeEn}</span>
      </div>
      <div class="bio" data-reveal>
        <p>2003年5月生まれ。現在、京都大学に在学しています（2027年卒業予定）。</p>
        <p>
          主にWebアプリケーションの開発に携わっています。インフラや品質、運用・保守までを含めて、一つひとつのサービスに責任を持って作り上げることを大切にしています。
        </p>
        <p>
          システムが本当に役立つものになるかどうかは、お客様の業務や業界をどれだけ深く理解できるかにかかっていると考えています。AIツールの進化によって「つくる」こと自体は身近になりましたが、何より大切なのは、それが現場でしっかりと「使える」ものであることです。
        </p>
        <p>
          お客様が本当に求めていることを丁寧にうかがい、その業務にきちんと合ったソフトウェアをお届けできるよう努めてまいります。
        </p>
      </div>
      <ul class="skills" data-reveal aria-label="得意な技術">
        {skills.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <section class="career-section container">
    <Wave color="#fff" position="top" />
    <div class="split">
      <div>
        <div class="eyebrow" data-reveal>CAREER</div>
        <h2 class="career-title" data-reveal>経歴</h2>
      </div>
      <div class="timeline">
        {/* 縦の線。画面に入ると上から下へ伸びる */}
        <div class="timeline-line" data-reveal="line" aria-hidden="true"></div>
        <ol class="timeline-list">
          {
            career.map((c, i) => (
              <li
                class:list={['timeline-item', { 'is-future': c.future, 'is-highlight': c.highlight }]}
                data-reveal
                style={`--reveal-delay: ${300 + i * 180}ms`}
              >
                <time class="timeline-date en">{c.date}</time>
                <span class="timeline-dot" aria-hidden="true"></span>
                <div class="timeline-card">
                  {c.tag && <span class="timeline-tag">{c.tag}</span>}
                  <p class="timeline-title">{c.title}</p>
                  {c.detail && <p class="timeline-detail">{c.detail}</p>}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: 120px 104px;
  }

  .portrait {
    width: 100%;
    aspect-ratio: 3 / 4;
    max-height: 420px;
    object-fit: cover;
    padding: 14px;
  }

  img.portrait {
    padding: 0;
  }

  .role {
    margin-bottom: 10px;
    font-size: 13px;
    color: var(--muted);
  }

  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 20px;
    margin-bottom: 40px;
  }

  .name-ja {
    font-size: 44px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .name-en {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--muted-2);
  }

  .bio {
    margin-bottom: 40px;
    font-size: 16px;
    line-height: 2.1;
    color: var(--text);
  }

  .bio p + p {
    margin-top: 1.2em;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skills li {
    padding: 6px 12px;
    border: 1px solid #ccc;
    font: 12px var(--font-mono);
  }

  .career-section {
    position: relative;
    padding-block: clamp(120px, 14vw, 180px) 104px;
    background: var(--bg-sub);
  }

  .career-title {
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.04em;
  }

  /* ---------- 経歴のタイムライン ---------- */

  .timeline {
    --date-w: clamp(92px, 9vw, 128px);
    --rail-w: 56px;
    --line-x: calc(var(--date-w) + var(--rail-w) / 2);
    position: relative;
  }

  .timeline-line {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: calc(var(--line-x) - 1px);
    width: 2px;
    background: var(--accent);
    transform-origin: top;
  }

  .timeline-list {
    display: grid;
    gap: clamp(48px, 6vw, 80px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: var(--date-w) var(--rail-w) minmax(0, 1fr);
    align-items: start;
  }

  /* 日付・玉は、カードの 1 行目（見出し）の高さにそろえる */
  .timeline-date,
  .timeline-dot {
    margin-top: 26px;
  }

  .timeline-date {
    font-size: clamp(18px, 1.8vw, 24px);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: right;
  }

  .timeline-dot {
    position: relative;
    z-index: 1;
    justify-self: center;
    width: 18px;
    height: 18px;
    border: 3px solid var(--accent);
    border-radius: 50%;
    background: var(--accent);
    /* 背景色の輪で、線が玉の後ろを通っているように見せる */
    box-shadow: 0 0 0 6px var(--bg-sub);
  }

  .timeline-card {
    position: relative;
    padding: 24px 30px;
    border-radius: 16px;
    background: #fff;
  }

  .timeline-title {
    font-family: var(--font-heading);
    font-size: clamp(18px, 1.6vw, 22px);
    font-weight: 700;
    line-height: 1.6;
  }

  .timeline-detail {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.9;
    color: var(--text);
  }

  .timeline-tag {
    display: inline-block;
    margin-bottom: 10px;
    padding: 3px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-deep);
    font-size: 12px;
    font-weight: 700;
  }

  /* 節目：大きめの玉とオレンジのカード */
  .is-highlight .timeline-dot {
    width: 24px;
    height: 24px;
    margin-top: 23px;
  }

  .is-highlight .timeline-card {
    background: var(--accent);
    color: #fff;
  }

  .is-highlight .timeline-detail {
    color: #fff;
    font-weight: 500;
  }

  .is-highlight .timeline-tag {
    background: #fff;
  }

  /* これからの予定は、中抜きの玉と控えめな文字で */
  .is-future .timeline-dot {
    background: #fff;
  }

  .is-future .timeline-date,
  .is-future .timeline-card {
    color: var(--muted);
  }

  .is-future .timeline-card {
    background: transparent;
    border: 1px dashed var(--num);
  }

  @media (max-width: 900px) {
    .portrait {
      max-width: 320px;
    }
  }

  @media (max-width: 600px) {
    .intro,
    .career-section {
      padding-block: 72px;
    }

    .name-ja {
      font-size: 32px;
    }

    .bio {
      font-size: 15px;
    }

    /* スマホでは線を左端に寄せ、日付を本文の上に置く */
    .timeline {
      --rail-w: 32px;
      --line-x: calc(var(--rail-w) / 2);
    }

    .timeline-item {
      grid-template-columns: var(--rail-w) minmax(0, 1fr);
      row-gap: 8px;
    }

    .timeline-dot {
      grid-column: 1;
      grid-row: 1;
    }

    .timeline-date,
    .timeline-dot,
    .is-highlight .timeline-dot {
      margin-top: 0;
    }

    .timeline-date {
      grid-column: 2;
      grid-row: 1;
      padding-left: 12px;
      text-align: left;
    }

    .timeline-card {
      grid-column: 2;
      margin-left: 12px;
      padding: 18px 20px;
    }

    .timeline-detail {
      font-size: 14px;
    }
  }
</style>
