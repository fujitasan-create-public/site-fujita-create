---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Wave from '../components/Wave.astro';
import { services, values } from '../data/site';
---

<BaseLayout description="合同会社Fujita-createの会社概要です。事業への想い、大切にしていること、事業内容をご紹介します。">
  <PageHero title="会社概要" en="ABOUT" note="PAGE VISUAL — 建築の細部（2560×720）" breadcrumb={false} waveColor="var(--accent)" />

  <section class="philosophy container">
    <div class="philosophy-inner">
      <div>
        <div class="eyebrow">PHILOSOPHY</div>
        <h2 class="philosophy-title">想い</h2>
        <p class="catch">本当に必要なものを、<br />誠実につくる。</p>
        <p class="body">
          プロダクトの価値は、<br />
          完成した日ではなく、<br />
          使われ続ける日々の中で生まれるものだと考えています。
        </p>
        <p class="body">
          当社はお客様の業務に、<br />
          真摯に向き合い、<br />
          本当に必要なものを見極め、<br />
          誠実なものづくりを通じて、<br />
          長く信頼される製品をお届けしてまいります。
        </p>
      </div>
      <img
        src="/images/philosophy.jpg"
        alt="オフィスでモニターに向かい、プログラムを書いている様子"
        class="philosophy-image"
        width="1051"
        height="1100"
        loading="lazy"
      />
    </div>
    <Wave color="var(--accent-soft)" flip />
  </section>

  <section class="values-section container">
    <div class="split">
      <div>
        <div class="eyebrow">VALUES</div>
        <h2 class="section-title">大切にしていること</h2>
      </div>
      <ol class="values">
        {
          values.map((v, i) => (
            <li class="value">
              <div class="value-num en">{String(i + 1).padStart(2, '0')}</div>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
    <Wave color="#fff" flip />
  </section>

  <section class="split container business">
    <div>
      <div class="eyebrow">BUSINESS</div>
      <h2 class="section-title">事業内容</h2>
    </div>
    <ol class="business-list">
      {
        services.map((s, i) => (
          <li>
            <span class="business-num en">{String(i + 1).padStart(2, '0')}</span>
            <span class="business-title">{s.title}</span>
            <span class="business-text">{s.short}</span>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .philosophy {
    position: relative;
    padding-block: 72px clamp(140px, 15vw, 200px);
    background: var(--accent);
    color: #fff;
  }

  .philosophy .eyebrow {
    color: #fff;
  }

  .philosophy .body {
    color: #fff;
    font-weight: 500;
  }

  .philosophy-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--split-gap);
    align-items: center;
  }

  .philosophy-title {
    margin-bottom: 28px;
    font-size: clamp(56px, 7.5vw, 104px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.04em;
  }

  .catch {
    margin-bottom: 40px;
    font-size: clamp(28px, 3.4vw, 46px);
    line-height: 1.5;
    font-weight: 700;
  }

  .philosophy-image {
    width: 100%;
    height: auto;
    aspect-ratio: 1051 / 1100;
    object-fit: cover;
    border-radius: 24px;
  }

  .body {
    font-size: 16px;
    line-height: 2.1;
    color: var(--text);
  }

  .body + .body {
    margin-top: 24px;
  }

  .values-section {
    position: relative;
    padding-block: 56px clamp(120px, 14vw, 180px);
    background: var(--bg-sub);
  }

  .values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .value {
    padding: 36px 32px;
    background: #fff;
    border-top: 2px solid var(--accent);
  }

  .value-num {
    margin-bottom: 28px;
    font-size: 32px;
    font-weight: 600;
    color: var(--num);
  }

  .value h3 {
    margin-bottom: 14px;
    font-size: 19px;
    font-weight: 700;
  }

  .value p {
    font-size: 14px;
    line-height: 1.9;
    color: var(--text-sub);
  }

  .business {
    padding-block: 104px;
  }

  .business-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--accent);
  }

  .business-list li {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 24px;
    align-items: baseline;
    padding: 28px 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .business-num {
    font-size: 20px;
    font-weight: 600;
    color: #aaa;
  }

  .business-title {
    font-size: 18px;
    font-weight: 700;
  }

  .business-text {
    font-size: 14px;
    line-height: 1.9;
    color: var(--text-sub);
  }

  @media (max-width: 900px) {
    .philosophy-inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .philosophy-image {
      max-width: 520px;
    }

    .business-list li {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 8px 16px;
    }

    .business-text {
      grid-column: 2;
    }
  }

  @media (max-width: 600px) {
    .philosophy {
      padding-block: 48px 96px;
    }

    .values-section {
      padding-block: 40px 96px;
    }

    .business {
      padding-block: 64px 72px;
    }

    .catch {
      margin-bottom: 28px;
    }

    .body {
      font-size: 15px;
    }

    .value {
      padding: 28px 24px;
    }
  }
</style>
