---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/site';

// トップのメインビジュアル。public/ に画像を置いてパスを入れると表示されます
const heroImage: string | undefined = undefined;

const links = [
  { href: '/about/', en: 'ABOUT', title: '会社概要', text: '開発への想いと、大切にしていること。' },
  { href: '/products/', en: 'PRODUCTS', title: 'プロダクト事例', text: '法人からのご依頼と、個人で開発したプロダクト。' },
  { href: '/profile/', en: 'PROFILE', title: '代表者について', text: '代表社員 藤田の経歴と得意分野。' },
];
---

<BaseLayout>
  <section class="hero" style={heroImage ? `background-image: url(${heroImage})` : undefined}>
    {!heroImage && <span class="hero-note">HERO — 建築の外壁・ガラス・コンクリート質感（モノクロ 2560×1360）</span>}
    <div class="hero-text">
      <div class="hero-eyebrow">BUILDING SYSTEMS THAT LAST</div>
      <h1>長く使える仕組みを、<br />確かな技術で。</h1>
      <p>Webアプリケーション・業務システムの受託開発と、インフラ／クラウド構築。</p>
    </div>
  </section>

  <section class="services container">
    <div class="services-head">
      <div>
        <div class="eyebrow">SERVICES</div>
        <h2>事業内容</h2>
      </div>
      <p>設計から開発、サーバーの構築・運用までを代表が一貫して担当します。小規模なご依頼や既存システムの改修からでもお受けします。</p>
    </div>
    <ol class="service-list">
      {
        services.map((s, i) => (
          <li class="service">
            <span class="service-num en">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{s.title}</h3>
              <span class="service-en en">{s.en}</span>
            </div>
            <p>{s.lead}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <nav class="links" aria-label="各ページへのリンク">
    {
      links.map((l) => (
        <a href={l.href} class="link-card">
          <div class="eyebrow">{l.en}</div>
          <div class="link-title">
            <span>{l.title}</span>
            <span aria-hidden="true">→</span>
          </div>
          <p>{l.text}</p>
        </a>
      ))
    }
  </nav>
</BaseLayout>

<style>
  .hero {
    position: relative;
    height: 680px;
    background:
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 12px),
      #3a3a3a;
    background-size: cover;
    background-position: center;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.4), transparent 60%);
  }

  .hero-note {
    position: absolute;
    right: 24px;
    top: 20px;
    font: 11px var(--font-mono);
    color: #aaa;
  }

  .hero-text {
    position: absolute;
    z-index: 1;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 80px;
    color: #fff;
  }

  .hero-eyebrow {
    font: 600 13px var(--font-en);
    letter-spacing: 0.32em;
    margin-bottom: 28px;
    color: #d0d0d0;
  }

  h1 {
    font-size: clamp(34px, 6vw, 76px);
    line-height: 1.28;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .hero-text p {
    margin-top: 28px;
    font-size: 16px;
    line-height: 1.9;
    color: #e4e4e4;
  }

  .services {
    padding-block: 120px 104px;
  }

  .services-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--split-gap);
    align-items: end;
    margin-bottom: 64px;
  }

  .services-head h2 {
    font-size: 42px;
    font-weight: 700;
  }

  .services-head p {
    max-width: 640px;
    font-size: 15px;
    line-height: 2;
    color: var(--text);
  }

  .service-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }

  .service {
    display: grid;
    grid-template-columns: clamp(60px, 9vw, 120px) minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 32px;
    align-items: center;
    padding: 40px 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .service-num {
    font-size: 44px;
    font-weight: 600;
    color: var(--num);
  }

  .service h3 {
    margin-bottom: 6px;
    font-size: 24px;
    font-weight: 700;
  }

  .service-en {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--muted-2);
  }

  .service p {
    font-size: 14px;
    line-height: 1.9;
    color: var(--text);
  }

  .links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }

  .link-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 56px var(--gutter);
  }

  .link-card + .link-card {
    border-left: 1px solid var(--line);
  }

  .link-card .eyebrow {
    font-size: 12px;
    margin-bottom: 0;
  }

  .link-title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 26px;
    font-weight: 700;
  }

  .link-title span:last-child {
    font-size: 20px;
    font-weight: 400;
  }

  .link-card p {
    font-size: 14px;
    line-height: 1.9;
    color: var(--text-sub);
  }

  @media (max-width: 900px) {
    .services-head {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .service {
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 12px 20px;
    }

    .service p {
      grid-column: 2;
    }

    .service-num {
      font-size: 32px;
    }

    .links {
      grid-template-columns: minmax(0, 1fr);
    }

    .link-card + .link-card {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 600px) {
    .hero {
      height: 520px;
    }

    .hero-note {
      display: none;
    }

    .hero-text {
      bottom: 48px;
    }

    .hero-eyebrow {
      font-size: 11px;
      margin-bottom: 20px;
    }

    .hero-text p {
      font-size: 14px;
    }

    .services {
      padding-block: 80px 72px;
    }

    .services-head {
      margin-bottom: 40px;
    }

    .services-head h2 {
      font-size: 32px;
    }

    .service {
      grid-template-columns: minmax(0, 1fr);
      padding: 28px 0;
    }

    .service p {
      grid-column: auto;
    }

    .service-num {
      font-size: 24px;
    }

    .service h3 {
      font-size: 20px;
    }

    .link-card {
      padding-block: 40px;
    }

    .link-title {
      font-size: 22px;
    }
  }
</style>
