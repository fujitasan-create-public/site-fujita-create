---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Wave from '../components/Wave.astro';
import { services, values } from '../data/site';

// 「大切にしていること」の写真。public/ に画像を置いてパスを入れると表示されます
const valuesImage: string | undefined = undefined;
---

<BaseLayout ctaWaveColor="var(--accent)" description="合同会社Fujita-createの会社概要です。事業への想い、大切にしていること、事業内容をご紹介します。">
  <PageHero title="会社概要" en="ABOUT" note="PAGE VISUAL — 建築の細部（2560×720）" breadcrumb={false} waveColor="var(--accent)" />

  <!-- オレンジ：想い（左に文字・右に写真） -->
  <section class="philosophy container">
    <div class="feature">
      <div class="feature-text">
        <div class="eyebrow">PHILOSOPHY</div>
        <h2 class="feature-title">想い</h2>
        <p class="catch">本当に必要なものを、<br />誠実につくる。</p>
        <p class="body">
          プロダクトの価値は、<br />
          完成した日ではなく、<br />
          使われ続ける日々の中で生まれるものだと考えています。
        </p>
        <p class="body">
          当社はお客様の業務に、<br />
          真摯に向き合い、<br />
          本当に必要なものを見極め、<br />
          誠実なものづくりを通じて、<br />
          長く信頼される製品をお届けしてまいります。
        </p>
      </div>
      <img
        src="/images/philosophy.jpg"
        alt="オフィスでモニターに向かい、プログラムを書いている様子"
        class="feature-image"
        width="1051"
        height="1100"
        loading="lazy"
      />
    </div>
    <Wave color="#fff" flip />
  </section>

  <!-- 白：大切にしていること（左に写真・右に文字） -->
  <section class="values-section container">
    <div class="feature feature-reverse">
      <div class="feature-text">
        <div class="eyebrow">VALUES</div>
        <h2 class="feature-title feature-title-long">大切にしていること</h2>
        <ol class="values">
          {
            values.map((v, i) => (
              <li class="value">
                <span class="value-num en">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{v.title}</h3>
                  <p>{v.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      {
        valuesImage ? (
          <img src={valuesImage} alt="" class="feature-image" loading="lazy" />
        ) : (
          <div class="feature-image placeholder">PHOTO（縦長 4:5 程度）</div>
        )
      }
    </div>
    <Wave color="var(--accent)" />
  </section>

  <!-- オレンジ：事業内容 -->
  <section class="business container">
    <div class="split">
      <div>
        <div class="eyebrow">BUSINESS</div>
        <h2 class="feature-title feature-title-long">事業内容</h2>
      </div>
      <ol class="business-list">
        {
          services.map((s, i) => (
            <li>
              <span class="business-num en">{String(i + 1).padStart(2, '0')}</span>
              <span class="business-title">{s.title}</span>
              <span class="business-text">{s.short}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- 共通：文字と写真の 2 列 ---------- */

  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--split-gap);
    align-items: center;
  }

  /* 写真を左・文字を右にする */
  .feature-reverse {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
  }

  .feature-reverse .feature-text {
    order: 2;
  }

  /* 文字のかたまりを列の中央に置く（行揃えは左のまま） */
  .feature-text {
    justify-self: center;
  }

  .feature-title {
    margin-bottom: 28px;
    font-size: clamp(56px, 7.5vw, 104px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.04em;
  }

  /* 文字数の多い見出しは、列に収まる大きさにする */
  .feature-title-long {
    font-size: clamp(36px, 4.6vw, 72px);
    letter-spacing: 0.02em;
  }

  .feature-image {
    width: 100%;
    height: auto;
    aspect-ratio: 1051 / 1100;
    object-fit: cover;
    border-radius: 24px;
  }

  .feature-image.placeholder {
    padding: 16px;
  }

  /* ---------- 想い（オレンジ） ---------- */

  .philosophy {
    position: relative;
    padding-block: 72px clamp(140px, 15vw, 200px);
    background: var(--accent);
    color: #fff;
  }

  .philosophy .eyebrow {
    color: #fff;
  }

  .catch {
    margin-bottom: 40px;
    font-size: clamp(28px, 3.4vw, 46px);
    line-height: 1.5;
    font-weight: 700;
  }

  .body {
    font-size: 16px;
    font-weight: 500;
    line-height: 2.1;
  }

  .body + .body {
    margin-top: 24px;
  }

  /* ---------- 大切にしていること（白） ---------- */

  .values-section {
    position: relative;
    padding-block: 40px clamp(140px, 15vw, 200px);
  }

  .values {
    display: grid;
    gap: 32px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .value {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 20px;
    padding-top: 28px;
    border-top: 2px solid var(--accent);
  }

  .value-num {
    font-size: clamp(28px, 2.6vw, 36px);
    font-weight: 600;
    line-height: 1.2;
    color: var(--accent);
  }

  .value h3 {
    margin-bottom: 10px;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 700;
    line-height: 1.4;
  }

  .value p {
    max-width: 30em;
    font-size: 16px;
    line-height: 2;
    color: var(--text);
  }

  /* ---------- 事業内容（オレンジ） ---------- */

  .business {
    position: relative;
    padding-block: 40px 104px;
    background: var(--accent);
    color: #fff;
  }

  .business .eyebrow {
    color: #fff;
  }

  .business-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid #fff;
  }

  .business-list li {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 24px;
    align-items: baseline;
    padding: 28px 0;
    border-bottom: 1px solid var(--accent-line);
  }

  .business-num {
    font-size: 20px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
  }

  .business-title {
    font-size: 20px;
    font-weight: 700;
  }

  .business-text {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.9;
  }

  @media (max-width: 900px) {
    .feature,
    .feature-reverse {
      grid-template-columns: minmax(0, 1fr);
    }

    .feature-text {
      justify-self: start;
    }

    /* スマホでは写真より先に文字を出す */
    .feature-reverse .feature-text {
      order: 0;
    }

    .feature-image {
      max-width: 520px;
    }

    .business-list li {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 8px 16px;
    }

    .business-text {
      grid-column: 2;
    }
  }

  @media (max-width: 600px) {
    .philosophy {
      padding-block: 48px 96px;
    }

    .values-section {
      padding-block: 32px 96px;
    }

    .business {
      padding-block: 32px 64px;
    }

    .catch {
      margin-bottom: 28px;
    }

    .body,
    .value p {
      font-size: 15px;
    }
  }
</style>
