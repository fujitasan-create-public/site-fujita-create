---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { services, values } from '../data/site';
---

<BaseLayout title="会社概要" description="合同会社Fujita-createが大切にしていること、事業への想いと事業内容をご紹介します。">
  <PageHero title="会社概要" en="ABOUT" note="PAGE VISUAL — 建築の細部（モノクロ 2560×720）" />

  <section class="split container philosophy">
    <div>
      <div class="eyebrow">PHILOSOPHY</div>
      <h2 class="section-title">想い</h2>
    </div>
    <div>
      <p class="catch">本当に必要なものを、<br />誠実につくる。</p>
      <p class="body">仕組みの価値は、完成した日ではなく、使われ続ける日々の中で生まれるものだと考えています。当社はお客様の業務に真摯に向き合い、本当に必要なものを見極め、誠実なものづくりを通じて、長く信頼される仕組みをお届けしてまいります。</p>
    </div>
  </section>

  <section class="values-section container">
    <div class="split">
      <div>
        <div class="eyebrow">VALUES</div>
        <h2 class="section-title">大切にしていること</h2>
      </div>
      <ol class="values">
        {
          values.map((v, i) => (
            <li class="value">
              <div class="value-num en">{String(i + 1).padStart(2, '0')}</div>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="split container business">
    <div>
      <div class="eyebrow">BUSINESS</div>
      <h2 class="section-title">事業内容</h2>
    </div>
    <ol class="business-list">
      {
        services.map((s, i) => (
          <li>
            <span class="business-num en">{String(i + 1).padStart(2, '0')}</span>
            <span class="business-title">{s.title}</span>
            <span class="business-text">{s.short}</span>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .philosophy {
    padding-block: 120px;
  }

  .catch {
    margin-bottom: 48px;
    font-size: 40px;
    line-height: 1.6;
    font-weight: 700;
  }

  .body {
    font-size: 16px;
    line-height: 2.1;
    color: var(--text);
  }

  .body + .body {
    margin-top: 24px;
  }

  .values-section {
    padding-block: 104px;
    background: var(--bg-sub);
  }

  .values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .value {
    padding: 36px 32px;
    background: #fff;
    border-top: 2px solid var(--ink);
  }

  .value-num {
    margin-bottom: 28px;
    font-size: 32px;
    font-weight: 600;
    color: var(--num);
  }

  .value h3 {
    margin-bottom: 14px;
    font-size: 19px;
    font-weight: 700;
  }

  .value p {
    font-size: 14px;
    line-height: 1.9;
    color: var(--text-sub);
  }

  .business {
    padding-block: 104px;
  }

  .business-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }

  .business-list li {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 24px;
    align-items: baseline;
    padding: 28px 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .business-num {
    font-size: 20px;
    font-weight: 600;
    color: #aaa;
  }

  .business-title {
    font-size: 18px;
    font-weight: 700;
  }

  .business-text {
    font-size: 14px;
    line-height: 1.9;
    color: var(--text-sub);
  }

  @media (max-width: 900px) {
    .business-list li {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 8px 16px;
    }

    .business-text {
      grid-column: 2;
    }
  }

  @media (max-width: 600px) {
    .philosophy,
    .values-section,
    .business {
      padding-block: 72px;
    }

    .catch {
      font-size: 26px;
      margin-bottom: 32px;
    }

    .body {
      font-size: 15px;
    }

    .value {
      padding: 28px 24px;
    }
  }
</style>
