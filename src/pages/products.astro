---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { products } from '../data/site';
---

<BaseLayout title="プロダクト事例" description="代表者がこれまでに携わった開発（在籍企業での業務・個人での受託を含みます）の一部をご紹介します。">
  <PageHero title="プロダクト事例" en="PRODUCTS" note="PAGE VISUAL — 質感（2560×720）" />

  <section class="container products">
    <div class="products-head">
      <p data-reveal>代表者がこれまでに携わった開発（在籍企業での業務・個人での受託を含みます）の中から、一部を抜粋して掲載しています。このほかにも、さまざまな業務システムやWebサービスの開発に携わってきました。守秘義務のある案件は概要のみ記載しています。</p>
    </div>

    <ul class="grid">
      {
        products.map((p, i) => (
          <li class="card" data-reveal style={`--reveal-delay: ${(i % 3) * 120}ms`}>
            {p.image ? (
              <img src={p.image} alt="" class="thumb" loading="lazy" />
            ) : (
              <div class="thumb placeholder">SCREENSHOT 4:3</div>
            )}
            <div class="meta">
              <span class="cat en">{p.cat}</span>
              <span class="year en">{p.period}</span>
            </div>
            <h3>{p.title}</h3>
            <p class="desc">{p.desc}</p>
            {(p.challenge || p.approach || p.result) && (
              <dl class="points">
                {p.challenge && (<div><dt>課題</dt><dd>{p.challenge}</dd></div>)}
                {p.approach && (<div><dt>取り組み</dt><dd>{p.approach}</dd></div>)}
                {p.result && (<div class="is-result"><dt>成果</dt><dd>{p.result}</dd></div>)}
              </dl>
            )}
            <div class="stack">{p.stack}</div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .products {
    padding-block: 96px 120px;
  }

  .products-head {
    margin-bottom: 48px;
  }

  .products-head p {
    max-width: 620px;
    font-size: 15px;
    line-height: 2;
    color: var(--text);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px 28px;
    margin: 0;
    padding: 40px 0 0;
    list-style: none;
    border-top: 2px solid var(--accent);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .thumb {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
  }

  .cat {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--muted);
  }

  .year {
    margin-left: auto;
    color: var(--muted);
  }

  h3 {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.6;
  }

  .desc {
    font-size: 14px;
    line-height: 1.9;
    color: var(--text-sub);
  }

  /* 課題・取り組み・成果 */
  .points {
    display: grid;
    gap: 14px;
    margin: 4px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .points div {
    display: grid;
    grid-template-columns: 4.5em minmax(0, 1fr);
    gap: 10px;
    align-items: start;
  }

  .points dt {
    padding: 2px 0;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-deep);
    font-size: 11px;
    font-weight: 700;
    text-align: center;
  }

  .points dd {
    margin: 0;
    font-size: 13px;
    line-height: 1.85;
    color: var(--text-sub);
  }

  .points .is-result dt {
    background: var(--accent);
    color: #fff;
  }

  .points .is-result dd {
    color: var(--ink);
    font-weight: 700;
  }

  .stack {
    font: 11px var(--font-mono);
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .products {
      padding-block: 64px 80px;
    }
  }
</style>
